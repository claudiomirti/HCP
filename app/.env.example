# Copy this file to .env.local and replace every placeholder with your own values.
# .env.local is git-ignored and must never be committed.

# --- Microsoft Entra ID (app registration) -------------------------------
# Directory (tenant) ID of the tenant hosting your Fabric workspace.
VITE_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# Application (client) ID of the SPA app registration created in docs/01-prerequisites.md.
VITE_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000

# --- Microsoft Fabric ----------------------------------------------------
# Workspace that holds the lakehouse, semantic model, report and data agent.
VITE_FABRIC_WORKSPACE_ID=00000000-0000-0000-0000-000000000000
# Power BI report item ID ("CMS Medicare Part D Star Schema").
VITE_POWERBI_REPORT_ID=00000000-0000-0000-0000-000000000000
# Fabric Data Agent item ID ("hcp-agent").
VITE_FABRIC_DATA_AGENT_ID=00000000-0000-0000-0000-000000000000
